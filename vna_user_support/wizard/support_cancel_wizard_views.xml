<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vna_support_cancel_wizard_form" model="ir.ui.view">
        <field name="name">vna.support.cancel.wizard.form</field>
        <field name="model">vna.support.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Hủy yêu cầu hỗ trợ">
                <group>
                    <field name="request_id" readonly="1"/>
                    <field name="cancel_reason" placeholder="Nhập lý do hủy yêu cầu..."/>
                </group>
                <footer>
                    <button name="action_confirm_cancel" string="Xác nhận hủy" type="object" class="btn-primary"/>
                    <button string="Đóng" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
