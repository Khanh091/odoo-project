<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vna_support_request_tree" model="ir.ui.view">
        <field name="name">vna.support.request.tree</field>
        <field name="model">vna.support.request</field>
        <field name="arch" type="xml">
            <tree string="Yêu cầu hỗ trợ" decoration-danger="priority == 'urgent'" decoration-warning="priority == 'high'" decoration-muted="not active">
                <field name="active" invisible="1"/>
                <field name="code"/>
                <field name="name"/>
                <field name="requester_id"/>
                <field name="request_type_id"/>
                <field name="priority"/>
                <field name="stage_id"/>
                <field name="assigned_user_id"/>
                <field name="create_date"/>
                <field name="closed_date"/>
            </tree>
        </field>
    </record>

    <record id="view_vna_support_request_kanban" model="ir.ui.view">
        <field name="name">vna.support.request.kanban</field>
        <field name="model">vna.support.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column">
                <field name="code"/>
                <field name="name"/>
                <field name="requester_id"/>
                <field name="request_type_id"/>
                <field name="priority"/>
                <field name="stage_id"/>
                <field name="assigned_user_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong><field name="name"/></strong>
                            </div>
                            <div class="text-muted"><field name="code"/></div>
                            <div>Loại: <field name="request_type_id"/></div>
                            <div>Người tạo: <field name="requester_id"/></div>
                            <div>Ưu tiên: <field name="priority"/></div>
                            <div>Người xử lý: <field name="assigned_user_id"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_vna_support_request_form" model="ir.ui.view">
        <field name="name">vna.support.request.form</field>
        <field name="model">vna.support.request</field>
        <field name="arch" type="xml">
            <form string="Yêu cầu hỗ trợ">
                <header>
                    <field name="can_manage_request" invisible="1"/>
                    <button name="action_assign_to_me" string="Nhận xử lý" type="object" class="btn-primary" groups="vna_user_support.group_vna_support_agent" invisible="assigned_user_id or not can_manage_request"/>
                    <button name="action_open_cancel_wizard" string="Hủy yêu cầu" type="object" groups="vna_user_support.group_vna_support_agent" invisible="stage_is_closed or not can_manage_request"/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': true}" invisible="not can_manage_request"/>
                    <field name="stage_id" widget="statusbar" readonly="1" class="o_vna_support_statusbar_readonly" invisible="can_manage_request"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Nhập tiêu đề yêu cầu hỗ trợ..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" readonly="1"/>
                            <field name="requester_id" readonly="1"/>
                            <field name="requester_email" readonly="1"/>
                            <field name="request_type_id"/>
                            <field name="priority"/>
                        </group>
                        <group>
                            <field name="assigned_user_id"/>
                            <field name="receiver_group_ids" widget="many2many_tags" readonly="1"/>
                            <field name="allowed_user_ids" widget="many2many_tags" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="closed_date" readonly="1"/>
                            <field name="stage_is_closed" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Nội dung">
                            <field name="description" placeholder="Mô tả chi tiết vấn đề hoặc yêu cầu cần hỗ trợ..."/>
                        </page>
                        <page string="Tệp đính kèm">
                            <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                        </page>
                        <page string="Hủy yêu cầu" invisible="not cancel_reason">
                            <field name="cancel_reason" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vna_support_request_pivot" model="ir.ui.view">
        <field name="name">vna.support.request.pivot</field>
        <field name="model">vna.support.request</field>
        <field name="arch" type="xml">
            <pivot string="Báo cáo yêu cầu hỗ trợ">
                <field name="request_type_id" type="row"/>
                <field name="stage_id" type="col"/>
                <field name="priority" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="view_vna_support_request_graph" model="ir.ui.view">
        <field name="name">vna.support.request.graph</field>
        <field name="model">vna.support.request</field>
        <field name="arch" type="xml">
            <graph string="Báo cáo yêu cầu hỗ trợ" type="bar">
                <field name="request_type_id"/>
                <field name="stage_id"/>
            </graph>
        </field>
    </record>

    <record id="view_vna_support_request_search" model="ir.ui.view">
        <field name="name">vna.support.request.search</field>
        <field name="model">vna.support.request</field>
        <field name="arch" type="xml">
            <search string="Tìm yêu cầu hỗ trợ">
                <field name="code"/>
                <field name="name"/>
                <field name="requester_id"/>
                <field name="request_type_id"/>
                <field name="stage_id"/>
                <field name="assigned_user_id"/>
                <filter name="my_requests" string="Yêu cầu của tôi" domain="[('requester_id', '=', uid)]"/>
                <filter name="need_handle" string="Cần xử lý" domain="[('allowed_user_ids', 'in', [uid]), ('stage_id.is_closed', '=', False)]"/>
                <filter name="closed" string="Đã đóng" domain="[('stage_id.is_closed', '=', True)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_stage" string="Trạng thái" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_type" string="Loại yêu cầu" context="{'group_by': 'request_type_id'}"/>
                    <filter name="group_assigned" string="Người xử lý" context="{'group_by': 'assigned_user_id'}"/>
                    <filter name="group_priority" string="Mức ưu tiên" context="{'group_by': 'priority'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_vna_support_request_my" model="ir.actions.act_window">
        <field name="name">Yêu cầu của tôi</field>
        <field name="res_model">vna.support.request</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('requester_id', '=', uid)]</field>
        <field name="context">{'default_requester_id': uid, 'search_default_my_requests': 1}</field>
        <field name="search_view_id" ref="view_vna_support_request_search"/>
    </record>

    <record id="action_vna_support_request_to_handle" model="ir.actions.act_window">
        <field name="name">Yêu cầu cần xử lý</field>
        <field name="res_model">vna.support.request</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('allowed_user_ids', 'in', [uid])]</field>
        <field name="context">{'search_default_group_stage': 1}</field>
        <field name="search_view_id" ref="view_vna_support_request_search"/>
    </record>

    <record id="action_vna_support_request_all" model="ir.actions.act_window">
        <field name="name">Tất cả yêu cầu</field>
        <field name="res_model">vna.support.request</field>
        <field name="view_mode">kanban,tree,form,pivot,graph</field>
        <field name="search_view_id" ref="view_vna_support_request_search"/>
        <field name="context">{'search_default_group_stage': 1}</field>
    </record>
</odoo>
