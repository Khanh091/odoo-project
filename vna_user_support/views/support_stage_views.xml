<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vna_support_stage_tree" model="ir.ui.view">
        <field name="name">vna.support.stage.tree</field>
        <field name="model">vna.support.stage</field>
        <field name="arch" type="xml">
            <tree string="Trạng thái">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="is_initial"/>
                <field name="is_closed"/>
                <field name="is_cancelled"/>
                <field name="fold"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_vna_support_stage_form" model="ir.ui.view">
        <field name="name">vna.support.stage.form</field>
        <field name="model">vna.support.stage</field>
        <field name="arch" type="xml">
            <form string="Trạng thái yêu cầu">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_initial"/>
                            <field name="is_closed"/>
                            <field name="is_cancelled"/>
                            <field name="fold"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vna_support_stage" model="ir.actions.act_window">
        <field name="name">Trạng thái</field>
        <field name="res_model">vna.support.stage</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
