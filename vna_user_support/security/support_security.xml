<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_vna_user_support" model="ir.module.category">
            <field name="name">VNA User Support</field>
            <field name="description">Quyền sử dụng kênh hỗ trợ người dùng Vietnam Airlines</field>
            <field name="sequence">30</field>
        </record>

        <record id="module_category_vna_user_support_teams" model="ir.module.category">
            <field name="name">VNA User Support Teams</field>
            <field name="description">Nhóm nghiệp vụ tiếp nhận yêu cầu hỗ trợ</field>
            <field name="sequence">31</field>
        </record>

        <record id="group_vna_support_user" model="res.groups">
            <field name="name">Người dùng yêu cầu hỗ trợ</field>
            <field name="category_id" ref="vna_user_support.module_category_vna_user_support"/>
        </record>

        <record id="group_vna_support_agent" model="res.groups">
            <field name="name">Nhân viên xử lý hỗ trợ</field>
            <field name="category_id" ref="vna_user_support.module_category_vna_user_support"/>
            <field name="implied_ids" eval="[(4, ref('vna_user_support.group_vna_support_user'))]"/>
        </record>

        <record id="group_vna_support_manager" model="res.groups">
            <field name="name">Quản trị kênh hỗ trợ</field>
            <field name="category_id" ref="vna_user_support.module_category_vna_user_support"/>
            <field name="implied_ids" eval="[(4, ref('vna_user_support.group_vna_support_agent'))]"/>
        </record>

        <record id="rule_vna_support_request_user_own" model="ir.rule">
            <field name="name">VNA Support Request - User own requests</field>
            <field name="model_id" ref="model_vna_support_request"/>
            <field name="domain_force">[('requester_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('vna_user_support.group_vna_support_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_vna_support_request_agent_assigned_team" model="ir.rule">
            <field name="name">VNA Support Request - Agent receiver teams</field>
            <field name="model_id" ref="model_vna_support_request"/>
            <field name="domain_force">['|', ('requester_id', '=', user.id), ('allowed_user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('vna_user_support.group_vna_support_agent'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_vna_support_request_manager_all" model="ir.rule">
            <field name="name">VNA Support Request - Manager all</field>
            <field name="model_id" ref="model_vna_support_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('vna_user_support.group_vna_support_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_vna_support_team_manager" model="ir.rule">
            <field name="name">VNA Support Teams - Manager access to groups</field>
            <field name="model_id" ref="base.model_res_groups"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('vna_user_support.group_vna_support_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
