<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="server_action_approve_selected_candidates" model="ir.actions.server">
        <field name="name">Approve Selected Candidates</field>
        <field name="model_id" ref="model_cv_repository_candidate"/>
        <field name="binding_model_id" ref="model_cv_repository_candidate"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_approve()</field>
    </record>

    <record id="server_action_reset_selected_candidates" model="ir.actions.server">
        <field name="name">Reset Selected Candidates to Review</field>
        <field name="model_id" ref="model_cv_repository_candidate"/>
        <field name="binding_model_id" ref="model_cv_repository_candidate"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_reset_to_review()</field>
    </record>
</odoo>
