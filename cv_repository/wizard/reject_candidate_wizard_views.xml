<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cv_repository_reject_candidate_wizard_form" model="ir.ui.view">
        <field name="name">cv.repository.reject.candidate.wizard.form</field>
        <field name="model">cv.repository.reject.candidate.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Candidates">
                <group>
                    <field name="candidate_ids" widget="many2many_tags"
                           domain="[('state', '=', 'review')]"/>
                    <field name="reason" placeholder="Enter the rejection reason..."/>
                </group>
                <footer>
                    <button name="action_confirm_rejection" type="object"
                            string="Reject" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cv_repository_reject_candidate_wizard"
            model="ir.actions.act_window">
        <field name="name">Reject Candidates</field>
        <field name="res_model">cv.repository.reject.candidate.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_cv_repository_reject_candidate_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
