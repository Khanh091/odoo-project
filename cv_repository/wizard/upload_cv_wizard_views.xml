<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cv_repository_upload_wizard_form" model="ir.ui.view">
        <field name="name">cv.repository.upload.wizard.form</field>
        <field name="model">cv.repository.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Import CVs">
                <group>
                    <field name="name"/>
                    <field name="attachment_ids" widget="many2many_binary"
                           options="{'accepted_file_extensions': '.pdf,.docx'}"/>
                    <field name="process_immediately"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_upload" type="object" string="Import"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cv_repository_upload_wizard" model="ir.actions.act_window">
        <field name="name">Import CV</field>
        <field name="res_model">cv.repository.upload.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_cv_repository_upload_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
