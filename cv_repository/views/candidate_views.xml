<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cv_repository_candidate_list" model="ir.ui.view">
        <field name="name">cv.repository.candidate.list</field>
        <field name="model">cv.repository.candidate</field>
        <field name="arch" type="xml">
            <tree decoration-warning="state == 'review'"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="current_position"/>
                <field name="location"/>
                <field name="state" widget="badge"/>
                <field name="possible_duplicate_id"/>
                <field name="batch_id"/>
                <field name="approved_at"/>
            </tree>
        </field>
    </record>

    <record id="view_cv_repository_candidate_form" model="ir.ui.view">
        <field name="name">cv.repository.candidate.form</field>
        <field name="model">cv.repository.candidate</field>
        <field name="arch" type="xml">
            <form string="Candidate">
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'review'"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'review'"/>
                    <button name="action_reset_to_review" type="object"
                            string="Reset to Review"
                            invisible="state not in ['approved', 'rejected']"/>
                    <button name="action_archive" type="object" string="Archive"
                            invisible="state == 'archived'"/>
                    <button name="action_open_cv_document" type="object" string="Open CV"/>
                    <button name="action_download_cv" type="object" string="Download CV"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="review,approved,rejected,archived"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="current_position"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="batch_id" readonly="1"/>
                            <field name="cv_document_id" readonly="1"/>
                            <field name="possible_duplicate_id" readonly="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Summary">
                            <field name="summary" nolabel="1"/>
                        </page>
                        <page string="Skills">
                            <field name="skill_text" nolabel="1"/>
                        </page>
                        <page string="Education">
                            <field name="education_json" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Experience">
                            <field name="experience_json" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Certifications">
                            <field name="certification_json" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Languages">
                            <field name="language_json" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Links">
                            <field name="link_json" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Warnings">
                            <field name="warning_json" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Source CV">
                            <group>
                                <field name="attachment_id" readonly="1"/>
                                <field name="cv_document_id" readonly="1"/>
                            </group>
                        </page>
                        <page string="Audit">
                            <group>
                                <group>
                                    <field name="approved_by"/>
                                    <field name="approved_at"/>
                                </group>
                                <group>
                                    <field name="rejected_by"/>
                                    <field name="rejected_at"/>
                                    <field name="rejection_reason"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_cv_repository_candidate_search" model="ir.ui.view">
        <field name="name">cv.repository.candidate.search</field>
        <field name="model">cv.repository.candidate</field>
        <field name="arch" type="xml">
            <search string="Candidates">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="current_position"/>
                <field name="location"/>
                <filter name="review" string="Waiting for Review" domain="[('state', '=', 'review')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <filter name="possible_duplicate" string="Possible Duplicate"
                        domain="[('possible_duplicate_id', '!=', False)]"/>
                <filter name="has_email" string="Has Email" domain="[('email', '!=', False)]"/>
                <filter name="has_phone" string="Has Phone" domain="[('phone', '!=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_batch" string="Batch" context="{'group_by': 'batch_id'}"/>
                    <filter name="group_position" string="Current Position"
                            context="{'group_by': 'current_position'}"/>
                    <filter name="group_location" string="Location"
                            context="{'group_by': 'location'}"/>
                    <filter name="group_created_month" string="Created Month"
                            context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cv_repository_candidate" model="ir.actions.act_window">
        <field name="name">Candidates</field>
        <field name="res_model">cv.repository.candidate</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_cv_repository_candidate_search"/>
    </record>
</odoo>
