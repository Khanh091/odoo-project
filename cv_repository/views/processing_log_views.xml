<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cv_repository_processing_log_list" model="ir.ui.view">
        <field name="name">cv.repository.processing.log.list</field>
        <field name="model">cv.repository.processing.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-danger="status == 'failed'"
                  decoration-warning="status == 'warning'"
                  decoration-success="status == 'success'">
                <field name="create_date"/>
                <field name="document_id"/>
                <field name="batch_id"/>
                <field name="candidate_id"/>
                <field name="operation"/>
                <field name="status" widget="badge"/>
                <field name="message"/>
                <field name="provider"/>
                <field name="model_name"/>
                <field name="duration_ms"/>
                <field name="created_by"/>
            </list>
        </field>
    </record>

    <record id="view_cv_repository_processing_log_form" model="ir.ui.view">
        <field name="name">cv.repository.processing.log.form</field>
        <field name="model">cv.repository.processing.log</field>
        <field name="arch" type="xml">
            <form string="Processing Log" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="document_id"/>
                            <field name="batch_id"/>
                            <field name="candidate_id"/>
                            <field name="operation"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="provider"/>
                            <field name="model_name"/>
                            <field name="duration_ms"/>
                            <field name="created_by"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <field name="message" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cv_repository_processing_log" model="ir.actions.act_window">
        <field name="name">Processing Logs</field>
        <field name="res_model">cv.repository.processing.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
