<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_tct_ip_whitelist_manager" model="res.groups">
        <field name="name">TCT IP Whitelist Manager</field>
        <field name="category_id" ref="base.module_category_administration"/>
    </record>

    <record id="rule_allowed_ip_manager" model="ir.rule">
        <field name="name">Allowed IP Manager Rule</field>
        <field name="model_id" ref="model_tct_allowed_ip"/>
        <field name="groups" eval="[(4, ref('group_tct_ip_whitelist_manager'))]"/>

        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>

        <field name="domain_force">[(1,'=',1)]</field>
    </record>

</odoo>