<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- TREE VIEW -->
    <record id="view_tct_allowed_ip_tree" model="ir.ui.view">
        <field name="name">tct.allowed.ip.tree</field>
        <field name="model">tct.allowed.ip</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="ip_address"/>
                <field name="group_ids"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_tct_allowed_ip_form" model="ir.ui.view">
        <field name="name">tct.allowed.ip.form</field>
        <field name="model">tct.allowed.ip</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <field name="name"/>
                        <field name="ip_address"/>
                        <field name="group_ids" widget="many2many_tags"/>
                        <field name="active"/>
                    </group>

                    <group>
                        <field name="note"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_tct_allowed_ip_search" model="ir.ui.view">
        <field name="name">tct.allowed.ip.search</field>
        <field name="model">tct.allowed.ip</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="ip_address"/>
                <field name="group_ids"/>

                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="inactive" string="Inactive" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

</odoo>
