<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_tct_high_privilege_2fa" model="ir.ui.view">
        <field name="name">res.users.form.tct.high.privilege.2fa</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">

            <!-- Insert security section -->
            <xpath expr="//sheet/notebook" position="inside">

                <page string="Security Policy">

                    <group string="High Privilege Security">

                        <!-- High privilege flag -->
                        <field name="is_high_privilege" readonly="1"/>

                        <!-- MFA status from auth_totp -->
                        <field name="totp_enabled" readonly="1"/>

                    </group>

                    <group string="TOTP QR" invisible="not is_high_privilege">
                        <field name="tct_totp_qrcode"
                               widget="image"
                               readonly="1"
                               options="{'reload': false}"/>
                        <field name="tct_totp_setup_secret"
                               readonly="1"
                               placeholder="Generated on next login if TOTP is not enabled"/>
                    </group>

                </page>

            </xpath>

        </field>
    </record>

</odoo>
