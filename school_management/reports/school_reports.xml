<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Báo cáo Danh sách học sinh theo lớp -->
    <record id="action_report_student_by_class" model="ir.actions.report">
        <field name="name">Danh sách học sinh theo lớp</field>
        <field name="model">school.class</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">school_management.report_student_list</field>
        <field name="report_file">school_management.report_student_list</field>
        <field name="print_report_name">'Danh_sach_hoc_sinh_%s' % (object.name)</field>
    </record>

    <!-- Báo cáo Bảng điểm học sinh -->
    <record id="action_report_student_grade" model="ir.actions.report">
        <field name="name">Bảng điểm học sinh</field>
        <field name="model">school.student</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">school_management.report_student_grade</field>
        <field name="report_file">school_management.report_student_grade</field>
        <field name="print_report_name">'Bang_diem_%s' % (object.name)</field>
    </record>
