<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Học sinh -->
    <record id="seq_school_student" model="ir.sequence">
        <field name="name">School Student</field>
        <field name="code">school.student</field>
        <field name="prefix">HS</field>
        <field name="padding">5</field>
    </record>

    <!-- Giáo viên -->
    <record id="seq_school_teacher" model="ir.sequence">
        <field name="name">School Teacher</field>
        <field name="code">school.teacher</field>
        <field name="prefix">GV</field>
        <field name="padding">5</field>
    </record>

    <!-- Lớp học -->
    <record id="seq_school_class" model="ir.sequence">
        <field name="name">School Class</field>
        <field name="code">school.class</field>
        <field name="prefix">L</field>
        <field name="padding">3</field>
    </record>

    <!-- Môn học -->
    <record id="seq_school_subject" model="ir.sequence">
        <field name="name">School Subject</field>
        <field name="code">school.subject</field>
        <field name="prefix">MH</field>
        <field name="padding">3</field>
    </record>

</odoo>