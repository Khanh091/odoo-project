<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_school_teacher_tree" model="ir.ui.view">
        <field name="name">school.teacher.tree</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <tree>
                <field name="teacher_code"/>
                <field name="name"/>
                <field name="gender"/>
                <field name="specialty"/>
                <field name="phone"/>
                <field name="start_date"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_school_teacher_form" model="ir.ui.view">
        <field name="name">school.teacher.form</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                        <h3>
                            <field name="teacher_code"/>
                        </h3>
                    </div>

                    <group>
                        <group>
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="specialty"/>
                        </group>

                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="user_id"/>
                            <field name="start_date"/>
                        </group>
                    </group>

                    <button
                        string="📚 Các lớp đang chủ nhiệm"
                        type="object"
                        name="action_view_classes"
                        class="btn-primary"/>

                    <notebook>

                        <page string="Môn giảng dạy">

                            <field
                                name="subject_ids"
                                widget="many2many_tags"
                                options="{'no_create': False}"/>


                        </page>

                        <page string="Phân công giảng dạy">

                            <field name="teaching_line_ids"
                                   context="{'default_teacher_id': id}">
                                <tree editable="bottom">
                                    <field name="class_id"/>
                                    <field name="subject_id"/>
                                </tree>
                            </field>

                        </page>

                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

</odoo>