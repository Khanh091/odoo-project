<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_school_grade_report_wizard_form" model="ir.ui.view">
        <field name="name">school.grade.report.wizard.form</field>
        <field name="model">school.grade.report.wizard</field>
        <field name="arch" type="xml">
            <form string="In Bảng điểm Lớp - Môn">
                <sheet>
                    <group>
                        <field name="class_id" invisible="1" readonly="1"/>
                        <field name="allowed_subject_ids" invisible="1"/>
                        <field name="subject_id" required="1" domain="[('id', 'in', allowed_subject_ids)]"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Xem / Xuất bảng điểm"
                            type="object"
                            name="action_print_report"
                            class="btn-primary"/>
                    <button string="Hủy"
                            type="special"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
