<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_school_grade_wizard_form" model="ir.ui.view">
        <field name="name">school.grade.wizard.form</field>
        <field name="model">school.grade.wizard</field>
        <field name="arch" type="xml">
            <form string="Nhập Điểm Hàng Loạt Theo Lớp">
                <sheet>
                    <group>
                        <field name="class_id" readonly="1"/>
                        <field name="allowed_subject_ids" invisible="1"/>
                        <!-- Chọn môn thuộc lớp -->
                        <field name="subject_id" required="1" domain="[('id', 'in', allowed_subject_ids)]"/>
                    </group>

                    <separator string="Nhập điểm cho học sinh"/>
                    <field name="line_ids" nolabel="1">
                        <tree editable="bottom" create="0" delete="0">
                            <field name="student_id" readonly="1" force_save="1"/>
                            <field name="midterm_score"/>
                            <field name="final_score"/>
                        </tree>
                    </field>
                </sheet>

                <footer>
                    <button string="Xuất bảng điểm"
                            type="object"
                            name="action_print_report"
                            class="btn-primary"/>
                    <button string="💾 Lưu Tất Cả Điểm"
                            type="object"
                            name="action_save_grades"
                            class="btn-primary"/>

                    <button string="Hủy"
                            type="special"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>