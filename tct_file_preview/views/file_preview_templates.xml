<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="file_preview_page" name="TCT File Preview Page">
        <html>
            <head>
                <title>
                    <t t-esc="attachment.name"/>
                </title>

                <style>
                    body {
                        margin: 0;
                        padding: 0;
                        background: #f5f5f5;
                        font-family: Arial, sans-serif;
                    }

                    .preview-header {
                        height: 48px;
                        padding: 0 16px;
                        display: flex;
                        align-items: center;
                        background: #ffffff;
                        border-bottom: 1px solid #ddd;
                        font-weight: 600;
                    }

                    .preview-container {
                        height: calc(100vh - 49px);
                        display: flex;
                        align-items: center;
                        justify-content: center;
                    }

                    img, video {
                        max-width: 100%;
                        max-height: 100%;
                    }

                    iframe, embed {
                        width: 100%;
                        height: 100%;
                        border: none;
                        background: white;
                    }

                    .unsupported {
                        background: white;
                        padding: 24px;
                        border-radius: 8px;
                    }
                </style>
            </head>

            <body>
                <div class="preview-header">
                    <t t-esc="attachment.name"/>
                </div>

                <div class="preview-container">

                    <t t-if="preview_type == 'image'">
                        <img t-att-src="preview_url"/>
                    </t>

                    <t t-elif="preview_type == 'video'">
                        <video controls="controls">
                            <source t-att-src="preview_url" t-att-type="attachment.mimetype"/>
                            Your browser does not support video preview.
                        </video>
                    </t>

                    <t t-elif="preview_type == 'pdf'">
                        <iframe t-att-src="preview_url"/>
                    </t>

                    <t t-elif="preview_type == 'office'">
                        <iframe t-att-src="preview_url"/>
                    </t>

                    <t t-elif="preview_type == 'text'">
                        <iframe t-att-src="preview_url"/>
                    </t>

                    <t t-else="">
                        <div class="unsupported">
                            This file type cannot be previewed.
                        </div>
                    </t>

                </div>
            </body>
        </html>
    </template>

</odoo>